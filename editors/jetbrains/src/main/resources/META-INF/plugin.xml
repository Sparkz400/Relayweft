<idea-plugin>
    <id>io.github.sparkz400.relayweft</id>
    <name>Relayweft</name>
    <vendor url="https://github.com/sparkz400/relayweft">sparkz400</vendor>
    <description><![CDATA[
<p>A thin client for <a href="https://github.com/sparkz400/relayweft">Relayweft</a> (<code>rw</code>),
which routes coding tasks to Codex and Claude Code agents.</p>
<p>The plugin starts <code>rw web --client</code> for your project and drives the same local API the
browser UI uses:</p>
<ul>
  <li>the agent tree and the activity log in a tool window, with a prompt box to start a task, and cancel;</li>
  <li>plan approval: edit, add, delete and reorder the subtasks, then approve or reject;</li>
  <li>change review in the IDE's diff viewer: accept or reject each hunk or file, or send the changes back with feedback;</li>
  <li>follow-ups to an agent, undo of the last task, and notifications when a task is done or failed or a question waits.</li>
</ul>
<p>Everything stays on your machine: rw listens on 127.0.0.1 only, and the plugin logs in with a
single-use secret it reads from rw's output. It needs <code>rw</code> installed.</p>
]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Relayweft" anchor="right" icon="/icons/relayweft.svg"
                    factoryClass="io.github.sparkz400.relayweft.ide.RwToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="io.github.sparkz400.relayweft.settings" displayName="Relayweft"
                                 instance="io.github.sparkz400.relayweft.ide.RwSettingsConfigurable"/>
        <notificationGroup id="Relayweft" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Relayweft.Start" class="io.github.sparkz400.relayweft.ide.StartAction"
                text="Start Relayweft" description="Start rw web --client for this project" icon="AllIcons.Actions.Execute"/>
        <action id="Relayweft.Stop" class="io.github.sparkz400.relayweft.ide.StopAction"
                text="Stop Relayweft" description="Stop rw (the running task is cancelled)" icon="AllIcons.Actions.Suspend"/>
        <action id="Relayweft.RunTask" class="io.github.sparkz400.relayweft.ide.RunTaskAction"
                text="Run Task…" description="Start a task, or queue it while one runs" icon="AllIcons.General.Add"/>
        <action id="Relayweft.CancelTask" class="io.github.sparkz400.relayweft.ide.CancelTaskAction"
                text="Cancel Running Task" description="Cancel the running task and stop its agents" icon="AllIcons.Actions.Cancel"/>
        <action id="Relayweft.ApprovePlan" class="io.github.sparkz400.relayweft.ide.ApprovePlanAction"
                text="Approve or Edit Plan…" description="Open the plan waiting for approval" icon="AllIcons.Actions.Edit"/>
        <action id="Relayweft.FollowUp" class="io.github.sparkz400.relayweft.ide.FollowUpAction"
                text="Follow Up with Agent…" description="Send a message to a finished or running agent" icon="AllIcons.General.Balloon"/>
        <action id="Relayweft.Undo" class="io.github.sparkz400.relayweft.ide.UndoLastTaskAction"
                text="Undo Last Task…" description="Show what rw undo would change and run it" icon="AllIcons.Actions.Rollback"/>
        <action id="Relayweft.OpenInBrowser" class="io.github.sparkz400.relayweft.ide.OpenInBrowserAction"
                text="Open in Browser" description="Open the full rw web UI with a single-use link" icon="AllIcons.General.Web"/>
        <action id="Relayweft.Settings" class="io.github.sparkz400.relayweft.ide.OpenSettingsAction"
                text="Relayweft Settings…" description="The rw executable and its arguments" icon="AllIcons.General.Settings"/>

        <action id="Relayweft.Review.Open" class="io.github.sparkz400.relayweft.ide.ReviewOpenAction"
                text="Review Changes…" description="Open the change set's diff" icon="AllIcons.Actions.Diff"/>
        <action id="Relayweft.Review.AcceptHunk" class="io.github.sparkz400.relayweft.ide.AcceptHunkAction"
                text="Accept Hunk at Caret" description="Relayweft review: accept the hunk at the caret" icon="AllIcons.Actions.Checked"/>
        <action id="Relayweft.Review.RejectHunk" class="io.github.sparkz400.relayweft.ide.RejectHunkAction"
                text="Reject Hunk at Caret" description="Relayweft review: reject the hunk at the caret" icon="AllIcons.Actions.Cancel"/>
        <action id="Relayweft.Review.AcceptFile" class="io.github.sparkz400.relayweft.ide.AcceptFileAction"
                text="Accept File" description="Relayweft review: accept this whole file"/>
        <action id="Relayweft.Review.RejectFile" class="io.github.sparkz400.relayweft.ide.RejectFileAction"
                text="Reject File" description="Relayweft review: reject this whole file"/>
        <action id="Relayweft.Review.Apply" class="io.github.sparkz400.relayweft.ide.ApplySelectedAction"
                text="Apply Selected Changes" description="Relayweft review: send the decision (accepted files and hunks land)" icon="AllIcons.Actions.Commit"/>
        <action id="Relayweft.Review.RejectAll" class="io.github.sparkz400.relayweft.ide.RejectAllAction"
                text="Reject All Changes" description="Relayweft review: keep the changes on a branch only" icon="AllIcons.Actions.GC"/>
        <action id="Relayweft.Review.Feedback" class="io.github.sparkz400.relayweft.ide.FeedbackAction"
                text="Send Back with Feedback…" description="Relayweft review: rerun the agent with your message" icon="AllIcons.Actions.Refresh"/>

        <group id="Relayweft.ToolWindowToolbar">
            <reference ref="Relayweft.Start"/>
            <reference ref="Relayweft.Stop"/>
            <reference ref="Relayweft.CancelTask"/>
            <separator/>
            <reference ref="Relayweft.ApprovePlan"/>
            <reference ref="Relayweft.FollowUp"/>
            <reference ref="Relayweft.Undo"/>
            <separator/>
            <reference ref="Relayweft.OpenInBrowser"/>
            <reference ref="Relayweft.Settings"/>
        </group>

        <group id="Relayweft.ReviewToolbar">
            <reference ref="Relayweft.Review.Open"/>
            <reference ref="Relayweft.Review.Apply"/>
            <reference ref="Relayweft.Review.Feedback"/>
            <reference ref="Relayweft.Review.RejectAll"/>
        </group>

        <group id="Relayweft.ToolsMenu" text="Relayweft" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <reference ref="Relayweft.Start"/>
            <reference ref="Relayweft.Stop"/>
            <reference ref="Relayweft.RunTask"/>
            <reference ref="Relayweft.CancelTask"/>
            <separator/>
            <reference ref="Relayweft.ApprovePlan"/>
            <reference ref="Relayweft.Review.Open"/>
            <reference ref="Relayweft.FollowUp"/>
            <reference ref="Relayweft.Undo"/>
            <separator/>
            <reference ref="Relayweft.OpenInBrowser"/>
            <reference ref="Relayweft.Settings"/>
        </group>
    </actions>
</idea-plugin>
