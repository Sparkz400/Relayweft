# Template: packaging/render-manifests.sh renders it to Formula/switchyard.rb.
# The formula is named switchyard and installs the sy command. It uses the
# release binaries, so it needs no bottles and no Go.
class Switchyard < Formula
  desc "Terminal app that routes coding work between the Codex CLI and Claude Code"
  homepage "https://github.com/sparkz400/switchyard"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/sparkz400/switchyard/releases/download/v{{VERSION}}/sy-darwin-arm64"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    end
    on_intel do
      url "https://github.com/sparkz400/switchyard/releases/download/v{{VERSION}}/sy-darwin-amd64"
      sha256 "{{SHA256_DARWIN_AMD64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/sparkz400/switchyard/releases/download/v{{VERSION}}/sy-linux-arm64"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/sparkz400/switchyard/releases/download/v{{VERSION}}/sy-linux-amd64"
      sha256 "{{SHA256_LINUX_AMD64}}"
    end
  end

  def install
    os = OS.mac? ? "darwin" : "linux"
    arch = Hardware::CPU.arm? ? "arm64" : "amd64"
    bin.install "sy-#{os}-#{arch}" => "sy"
  end

  def caveats
    <<~EOS
      Run `sy doctor` to check the codex and claude CLIs.
      Update with `brew upgrade switchyard`.
    EOS
  end

  test do
    assert_equal "switchyard #{version}", shell_output("#{bin}/sy version").strip
  end
end
