# Template: packaging/render-manifests.sh renders it to Formula/relayweft.rb.
# The formula is named relayweft and installs the rw command. It uses the
# release binaries, so it needs no bottles and no Go.
class Relayweft < Formula
  desc "Terminal app that routes coding work between the Codex CLI and Claude Code"
  homepage "https://github.com/sparkz400/relayweft"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/sparkz400/relayweft/releases/download/v{{VERSION}}/rw-darwin-arm64"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    end
    on_intel do
      url "https://github.com/sparkz400/relayweft/releases/download/v{{VERSION}}/rw-darwin-amd64"
      sha256 "{{SHA256_DARWIN_AMD64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/sparkz400/relayweft/releases/download/v{{VERSION}}/rw-linux-arm64"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/sparkz400/relayweft/releases/download/v{{VERSION}}/rw-linux-amd64"
      sha256 "{{SHA256_LINUX_AMD64}}"
    end
  end

  def install
    os = OS.mac? ? "darwin" : "linux"
    arch = Hardware::CPU.arm? ? "arm64" : "amd64"
    bin.install "rw-#{os}-#{arch}" => "rw"
    # Make the raw download executable before generating completion.
    chmod 0755, bin/"rw"
    generate_completions_from_executable(bin/"rw", "completion")
  end

  def caveats
    <<~EOS
      Run `rw doctor` to check the codex and claude CLIs.
      Update with `brew upgrade relayweft`.
    EOS
  end

  test do
    assert_equal "relayweft #{version}", shell_output("#{bin}/rw version").strip
    assert_path_exists bash_completion/"rw"
    assert_path_exists zsh_completion/"_rw"
    assert_path_exists fish_completion/"rw.fish"
  end
end
