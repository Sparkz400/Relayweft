pkgbase = switchyard-cli-bin
	pkgdesc = Terminal app that routes coding work between the Codex CLI and Claude Code (sy)
	pkgver = {{VERSION}}
	pkgrel = 1
	url = https://github.com/sparkz400/switchyard
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = git
	provides = sy
	conflicts = sy
	options = !strip
	options = !debug
	source = LICENSE-{{VERSION}}::https://raw.githubusercontent.com/sparkz400/switchyard/v{{VERSION}}/LICENSE
	source = README-{{VERSION}}.md::https://raw.githubusercontent.com/sparkz400/switchyard/v{{VERSION}}/README.md
	sha256sums = {{SHA256_LICENSE}}
	sha256sums = {{SHA256_README}}
	source_x86_64 = sy-{{VERSION}}-x86_64::https://github.com/sparkz400/switchyard/releases/download/v{{VERSION}}/sy-linux-amd64
	sha256sums_x86_64 = {{SHA256_LINUX_AMD64}}
	source_aarch64 = sy-{{VERSION}}-aarch64::https://github.com/sparkz400/switchyard/releases/download/v{{VERSION}}/sy-linux-arm64
	sha256sums_aarch64 = {{SHA256_LINUX_ARM64}}

pkgname = switchyard-cli-bin
