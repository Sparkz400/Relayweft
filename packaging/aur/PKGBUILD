# Maintainer: Sparkz400 <62327601+Sparkz400@users.noreply.github.com>
pkgname=relayweft-bin
pkgver=0.3.0
pkgrel=1
pkgdesc='Terminal app that routes coding work between the Codex CLI and Claude Code (rw)'
arch=('x86_64' 'aarch64')
url='https://github.com/sparkz400/relayweft'
license=('MIT')
depends=('git')
provides=('relayweft')
conflicts=('relayweft' 'rw')
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/sparkz400/relayweft/v$pkgver/LICENSE"
        "README-$pkgver.md::https://raw.githubusercontent.com/sparkz400/relayweft/v$pkgver/README.md")
source_x86_64=("rw-$pkgver-x86_64::https://github.com/sparkz400/relayweft/releases/download/v$pkgver/rw-linux-amd64")
source_aarch64=("rw-$pkgver-aarch64::https://github.com/sparkz400/relayweft/releases/download/v$pkgver/rw-linux-arm64")
sha256sums=('da2fcaa417d4f76ac3d9e60f933459c7ed80bbe60552e76dbcdc86201300a9e5'
            'd32f9a980e13f4075ee2ebb5433bd70b4c8a6c258d5f3e1c7843c838d9405476')
sha256sums_x86_64=('610a21696b116519b592ce1a0a3f2f2ab4515f66ee442e6535f1d1d7d6158784')
sha256sums_aarch64=('2a65fa42c4f61b0b3a7e99cd301d03d50233d80ddb8d869e61ca2d1e2937a0e8')

package() {
  install -Dm755 "rw-$pkgver-$CARCH" "$pkgdir/usr/bin/rw"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "README-$pkgver.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  # `rw completion` arrived in v0.4.0.
  if [ "$(vercmp "$pkgver" 0.4.0)" -ge 0 ]; then
    "$pkgdir/usr/bin/rw" completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/rw"
    "$pkgdir/usr/bin/rw" completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_rw"
    "$pkgdir/usr/bin/rw" completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/rw.fish"
  fi
}
